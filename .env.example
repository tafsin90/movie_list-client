# Public URL of the Express API. This value is bundled into the browser.
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Local Next.js origin used by Better Auth.
BETTER_AUTH_URL=http://localhost:3000

# Use the same MongoDB connection string as the server.
MONGO_URI=mongodb://127.0.0.1:27017

# Set a long, unique secret for Better Auth.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional: required only when enabling Google sign-in.
GOOGLE_CLIENT_ID=your-google-client-ID
GOOGLE_CLIENT_SECRET=your-google-client-SECRET

DB_USER=your_database_username
DB_USER_PASS=db-user-password

TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
OMDB_API_KEY=
